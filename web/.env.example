# Local dev server (fairpool/devserver, npm start): e.g. http://localhost:54321. Takes precedence over Supabase.
VITE_API_URL=
# Supabase project (Settings > API). Leave all empty to run the in-browser demo database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Address printed in QR codes. Defaults to the current site address.
VITE_PUBLIC_BASE_URL=
